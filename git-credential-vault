#!/usr/bin/env python3
"""
git-credential-vault
====================
Helper d'identifiants Git qui trouve le bon token selon la forge appelée,
en le cherchant successivement :
  1. dans les variables d'environnement (si elles sont propagées) ;
  2. sinon directement dans Vault, via VAULT_ADDR / VAULT_TOKEN qui sont,
     eux, toujours présents dans la session SSP Cloud.

Avantages :
  - un seul helper pour TOUTES les forges (routage automatique par domaine) ;
  - aucun token écrit sur disque ;
  - fonctionne même si les secrets Vault ne sont pas propagés au shell.

Installé par setup_git.sh dans /home/onyxia/.local/bin/
Git l'appelle automatiquement : jamais à lancer à la main.
"""

import json
import os
import sys
import urllib.request

# Domaine -> (nom d'utilisateur, nom de la variable/clé Vault)
FORGES = {
    "github.com":      ("melinahillion", "GITHUB_TOKEN"),
    "gitlab.com":      ("melinahillion", "GITLAB_TOKEN"),
    "gitlab.insee.fr": ("melinahillion", "GITLAB_INSEE_TOKEN"),
}

TIMEOUT = 5
MAX_DEPTH = 4


def vault_request(url):
    """Appel GET authentifié sur l'API Vault."""
    token = os.environ.get("VAULT_TOKEN", "")
    req = urllib.request.Request(url, headers={"X-Vault-Token": token})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return json.load(resp)


def vault_find_key(key_name):
    """
    Cherche `key_name` dans l'arborescence des secrets de l'utilisateur.
    Renvoie la valeur, ou None.
    """
    addr = os.environ.get("VAULT_ADDR", "").rstrip("/")
    token = os.environ.get("VAULT_TOKEN", "")
    mount = os.environ.get("VAULT_MOUNT", "onyxia-kv")
    top = os.environ.get("VAULT_TOP_DIR", "").strip("/")

    if not addr or not token:
        return None

    def walk(path, depth=0):
        if depth > MAX_DEPTH:
            return None
        clean = path.strip("/")

        # a) tenter de lire ce chemin comme un secret
        try:
            data = vault_request(f"{addr}/v1/{mount}/data/{clean}")
            value = (data.get("data") or {}).get("data", {}).get(key_name)
            if value:
                return value
        except Exception:
            pass

        # b) sinon, le lister comme un dossier et descendre
        try:
            listing = vault_request(f"{addr}/v1/{mount}/metadata/{clean}?list=true")
            for entry in (listing.get("data") or {}).get("keys", []):
                sub = f"{clean}/{entry}" if clean else entry
                found = walk(sub, depth + 1)
                if found:
                    return found
        except Exception:
            pass

        return None

    return walk(top)


def read_git_request():
    """Lit les paires clé=valeur que git envoie sur stdin."""
    fields = {}
    for line in sys.stdin:
        line = line.strip()
        if not line:
            break
        if "=" in line:
            k, v = line.split("=", 1)
            fields[k] = v
    return fields


def main():
    # Git appelle le helper avec get / store / erase. On ne gère que 'get'.
    if len(sys.argv) < 2 or sys.argv[1] != "get":
        return

    fields = read_git_request()
    host = fields.get("host", "")

    if host not in FORGES:
        return  # forge inconnue : on laisse git demander autrement

    username, key_name = FORGES[host]

    # 1) variable d'environnement, si propagée
    token = os.environ.get(key_name, "").strip()

    # 2) sinon, lecture directe dans Vault
    if not token:
        token = (vault_find_key(key_name) or "").strip()

    if token:
        sys.stdout.write(f"username={username}\n")
        sys.stdout.write(f"password={token}\n")
    else:
        # Message sur stderr : visible par l'utilisateur, jamais envoyé à git.
        sys.stderr.write(
            f"[git-credential-vault] Aucun token trouve pour {host} "
            f"(cle attendue : {key_name}). Verifie le secret dans Vault.\n"
        )


if __name__ == "__main__":
    main()
